# Resend, newsletter signups + welcome email (server-side only)
# Get a key at https://resend.com/api-keys
# Create an Audience at https://resend.com/audiences, then copy its ID below.
# RESEND_FROM is the verified sender for the welcome email. Verify the domain at
# https://resend.com/domains, then use an address on it, e.g.
#   RESEND_FROM="Business Name <hello@customer-domain.com>"
# If RESEND_FROM is unset, signups still add the contact but skip the welcome email.
# These vars are read by src/server/subscribe.ts (newsletter) AND src/server/contact.ts
# (lead/contact + quote form notifications), RESEND_API_KEY + RESEND_FROM power both.
# For local dev, copy this file to .env.local and fill in real values.
# For Cloudflare Pages, set these vars in the Pages project's Environment Variables.

RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM=

# Instagram feed (server-side only), read by src/server/instagram.ts
# Long-lived access token for the customer's Instagram account, generated in the
# Meta app (Instagram API setup -> Generate access tokens). It powers the
# homepage Instagram grid. The token lasts ~60 days and must be refreshed before
# it expires (https://graph.instagram.com/refresh_access_token). If unset, the
# Instagram section simply doesn't render.
# For Cloudflare, set this in the project's Environment Variables (encrypted).
INSTAGRAM_TOKEN=

# Sable site-connector (@asksable/site-connector), booking, contact, analytics.
# Client-exposed (VITE_ prefix). When both the API URL and site slug are set, the
# site connects to the customer's Sable workspace: the booking widget + the custom
# QuoteWizard submit through it, and cookieless pageviews are reported. Leave blank
# to run the shell standalone (the connector stays dormant). You can also hardcode
# these per client in src/config/sable.ts instead of using env.
#   VITE_SABLE_PUBLIC_API_URL, Sable public API (e.g. https://<deployment>.convex.site)
#   VITE_SABLE_SITE_SLUG     , the workspace's site slug
#   VITE_SABLE_TIMEZONE      , IANA tz, defaults to America/Chicago
VITE_SABLE_PUBLIC_API_URL=
VITE_SABLE_SITE_SLUG=
VITE_SABLE_TIMEZONE=
